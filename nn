-- Tiện ích
local function ParseExpirationTime(timeFormat)
    if timeFormat == "/0" then return math.huge end
    local slashes, unit = timeFormat:match("^(/*)(%w)$")
    if not slashes or not unit then return nil end
    local count = #slashes
    local multiplier = 0
    if unit == "S" then multiplier = 1
    elseif unit == "H" then multiplier = 3600
    elseif unit == "D" then multiplier = 86400
    elseif unit == "Y" then multiplier = 31536000
    end
    return count * multiplier
end

local function UpdateStatus(text, color)
    Status.Text = text
    Status.TextColor3 = color
end

-- ===================================
-- LOGIC KIỂM TRA KEY (KHÔNG CÓ ĐUÔI)
-- ===================================
VerifyBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyInput.Text
    enteredKey = string.gsub(enteredKey, "%s+", "")
    enteredKey = string.gsub(enteredKey, "|", "")
    
    if enteredKey == "" then
        UpdateStatus("Please enter a key.", Color3.fromRGB(255, 100, 100))
        return
    end

    -- Khách chỉ nhập Key dạng: 12 chars + K + 20 chars + E + 3 chars (Độ dài chuẩn: 37)
    -- Không nhập đuôi ///D
    if not enteredKey:match("^............K....................E...$") then
        UpdateStatus("Invalid Key Format! (Do not include //D at the end)", Color3.fromRGB(255, 100, 100))
        return
    end

    UpdateStatus("Checking key online...", Color3.fromRGB(200, 200, 200))
    
    local success, githubContent = pcall(function()
        return game:HttpGet(RAW_GITHUB_URL)
    end)

    if not success then
        UpdateStatus("Failed to connect to server!", Color3.fromRGB(255, 100, 100))
        return
    end

    -- Tìm Key trong Github, và tách ĐUÔI THỜI GIAN ra từ dòng đó
    -- Ký tự %S+ sẽ lấy toàn bộ đoạn mã thời gian nằm sát ngay sau đoạn key 37 ký tự
    local timeFormat = githubContent:match(enteredKey .. "([/%w]+)")
    
    if not timeFormat then
        UpdateStatus("Key not found in database!", Color3.fromRGB(255, 100, 100))
        return
    end

    -- Nếu tìm thấy, lấy đuôi đó để tính toán Hạn sử dụng
    local durationSeconds = ParseExpirationTime(timeFormat)
    if not durationSeconds then
        UpdateStatus("Corrupted Key Duration on server!", Color3.fromRGB(255, 100, 100))
        return
    end

    -- Lưu thời gian bắt đầu dùng vào máy người dùng
    local fileName = "KeySystem_" .. enteredKey .. ".txt"
    if isfile and readfile and writefile then
        if isfile(fileName) then
            local startTime = tonumber(readfile(fileName))
            if startTime then
                local elapsed = os.time() - startTime
                if elapsed > durationSeconds then
                    UpdateStatus("Key has expired!", Color3.fromRGB(255, 100, 100))
                    return
                end
            end
        else
            writefile(fileName, tostring(os.time()))
        end
    end

    UpdateStatus("Authentication Successful!", Color3.fromRGB(100, 255, 100))
    
    -- Hiệu ứng tắt UI Mượt mà sử dụng GroupTransparency
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(MainFrame, tweenInfo, {GroupTransparency = 1, Size = UDim2.new(0, 380, 0, 230)}):Play()
    
    task.wait(0.5)
    KeySystemGUI:Destroy()
    LoadMainUI()
end)

