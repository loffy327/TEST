local function ParseExpirationTime(timeFormat)
    if timeFormat == "/0" then return math.huge end
    local slashes, unit = timeFormat:match("^(/*)(%w)$")
    if not slashes or not unit then return nil end
    local count = #slashes
    local multiplier = 0
    if unit == "S" then multiplier = 1
    elseif unit == "H" then multiplier = 3600
    elseif unit == "D" then multiplier = 86400
    elseif unit == "Y" then multiplier = 31536000
    end
    return count * multiplier
end

