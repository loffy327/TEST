-- Time Parser Function
local function ParseExpirationTime(timeFormat)
    if timeFormat == "/0" then return math.huge end -- Lifetime
    
    local slashes, unit = timeFormat:match("^(/*)(%w)$")
    if not slashes or not unit then return nil end
    
    local count = #slashes
    local multiplier = 0
    
    if unit == "S" then multiplier = 1 -- Seconds
    elseif unit == "H" then multiplier = 3600 -- Hours
    elseif unit == "D" then multiplier = 86400 -- Days
    elseif unit == "Y" then multiplier = 31536000 -- Years
    end
    
    return count * multiplier
end

-- Key Verification Logic
SubmitButton.MouseButton1Click:Connect(function()
    local enteredKey = KeyInput.Text
    enteredKey = string.gsub(enteredKey, "%s+", "") -- Remove spaces
    enteredKey = string.gsub(enteredKey, "|", "") -- Remove pipes if they copy-pasted them
    
    if enteredKey == "" then
        Status.Text = "Please enter a key."
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    -- Validate Format: 12 chars + K + 20 chars + E + 3 chars + Time Format
    local timeFormat = enteredKey:match("^............K....................E...(.+)$")
    if not timeFormat then
        Status.Text = "Invalid Key Format!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    Status.Text = "Checking key online..."
    Status.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    -- Fetch raw github keys
    local success, githubContent = pcall(function()
        return game:HttpGet(RAW_GITHUB_URL)
    end)

    if not success then
        Status.Text = "Failed to connect to server!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    -- Check if key exists in github content
    if not string.find(githubContent, enteredKey, 1, true) then
        Status.Text = "Key not found!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    -- Parse duration
    local durationSeconds = ParseExpirationTime(timeFormat)
    if not durationSeconds then
        Status.Text = "Corrupted Key Duration!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    -- Expiration Check using local files (Requires Executor with writefile/readfile)
    local fileName = "KeySystem_" .. enteredKey .. ".txt"
    if isfile and readfile and writefile then
        if isfile(fileName) then
            local startTime = tonumber(readfile(fileName))
            if startTime then
                local elapsed = os.time() - startTime
                if elapsed > durationSeconds then
                    Status.Text = "Key has expired!"
                    Status.TextColor3 = Color3.fromRGB(255, 100, 100)
                    return
                end
            end
        else
            -- First time using this key, save current time
            writefile(fileName, tostring(os.time()))
        end
    else
        warn("Executor does not support file saving. Key expiration cannot be tracked locally.")
    end

    Status.Text = "Key Valid! Loading..."
    Status.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    -- Fade out animation
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeTween = TweenService:Create(MainFrame, tweenInfo, {BackgroundTransparency = 1})
    TweenService:Create(Title, tweenInfo, {TextTransparency = 1}):Play()
    TweenService:Create(KeyInput, tweenInfo, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
    TweenService:Create(SubmitButton, tweenInfo, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
    TweenService:Create(Status, tweenInfo, {TextTransparency = 1}):Play()
    
    fadeTween:Play()
    fadeTween.Completed:Wait()
    
    -- Destroy Key UI and load main script
    KeySystemGUI:Destroy()
    LoadMainUI()
end)
