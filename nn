-- ===================================
-- LOGIC KIỂM TRA KEY GỘP (CHO CẢ NÚT BẤM VÀ AUTO)
-- ===================================
local verifying = false

local function ProcessKeyVerification()
    if verifying then return end
    verifying = true
    
    local enteredKey = KeyInput.Text
    enteredKey = string.gsub(enteredKey, "%s+", "")
    enteredKey = string.gsub(enteredKey, "|", "")
    
    if enteredKey == "" then
        PlaySound("683523095", 0.5) -- Error
        UpdateStatus("Please enter a key.", Color3.fromRGB(255, 100, 100))
        verifying = false
        return
    end

    if not enteredKey:match("^............K....................E...$") then
        PlaySound("683523095", 0.5)
        UpdateStatus("Invalid Key Format!", Color3.fromRGB(255, 100, 100))
        verifying = false
        return
    end

    PlaySound("683108986", 0.3) -- Click
    UpdateStatus("Authenticating with server...", Color3.fromRGB(200, 200, 200))
    
    local success, githubContent = pcall(function()
        return game:HttpGet(RAW_GITHUB_URL)
    end)

    if not success then
        PlaySound("683523095", 0.5)
        UpdateStatus("Failed to connect to server!", Color3.fromRGB(255, 100, 100))
        verifying = false
        return
    end

    local timeFormat = githubContent:match(enteredKey .. "([^A\r\n]+)")
    
    if not timeFormat then
        PlaySound("683523095", 0.5)
        UpdateStatus("Key not found or blacklisted!", Color3.fromRGB(255, 100, 100))
        verifying = false
        return
    end

    local durationSeconds = ParseExpirationTime(timeFormat)
    if not durationSeconds then
        PlaySound("683523095", 0.5)
        UpdateStatus("Corrupted server response!", Color3.fromRGB(255, 100, 100))
        verifying = false
        return
    end

    local fileName = "KeySystem_" .. enteredKey .. ".txt"
    if isfile and readfile and writefile then
        if isfile(fileName) then
            local startTime = tonumber(readfile(fileName))
            if startTime then
                local elapsed = os.time() - startTime
                if elapsed > durationSeconds then
                    PlaySound("683523095", 0.5)
                    UpdateStatus("Your key has expired!", Color3.fromRGB(255, 100, 100))
                    
                    -- Xoá auto save đi vì key đã hết hạn
                    if isfile(SavedKeyFile) then
                        pcall(function() delfile(SavedKeyFile) end)
                    end
                    
                    verifying = false
                    return
                end
            end
        else
            writefile(fileName, tostring(os.time()))
        end
        
        -- Lưu lại key hợp lệ để lần sau tự vào
        writefile(SavedKeyFile, enteredKey)
    end

    PlaySound("2865227271", 0.6) -- Success
    UpdateStatus("Authentication Successful!", Color3.fromRGB(100, 255, 100))
    
    -- Fade out
    local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(MainFrame, tweenInfo, {GroupTransparency = 1, Size = UDim2.new(0, 380, 0, 230)}):Play()
    TweenService:Create(Blur, TweenInfo.new(0.6), {Size = 0}):Play()
    
    task.wait(0.6)
    Blur:Destroy()
    KeySystemGUI:Destroy()
    LoadMainUI()
end

