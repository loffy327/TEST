-- NOTIFICATIONS
--============================================================

local NotifyIcons = {
	Info    = { Glyph = "ℹ", Color = "Accent" },
	Success = { Glyph = "✓", Color = "Success" },
	Warn    = { Glyph = "!", Color = "Danger" },
	Error   = { Glyph = "✕", Color = "Danger" },
}

function Library:Notify(config)
	config = config or {}
	local title = config.Title or "Notification"
	local content = config.Content or ""
	local duration = config.Duration or 3
	local theme = Themes[config.Theme or "Dark"]
	local kind = NotifyIcons[config.Type] or NotifyIcons.Info
	local accentColor = theme[kind.Color]

	local frame = create("Frame", {
		BackgroundColor3 = theme.Surface,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		Parent = self.NotifyHolder,
	}, { corner(8), stroke(theme.Border) })

	create("Frame", { -- accent side bar
		BackgroundColor3 = accentColor,
		Size = UDim2.new(0, 4, 1, 0),
		Parent = frame,
	}, { corner(2) })

	local body = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = frame,
	}, { padding(12) })

	local iconBadge = create("TextLabel", {
		Text = kind.Glyph,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = accentColor,
		BackgroundColor3 = accentColor,
		BackgroundTransparency = 0.85,
		Size = UDim2.new(0, 22, 0, 22),
		Parent = body,
	}, { corner(11) })

	create("TextLabel", {
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 30, 0, 0),
		Size = UDim2.new(1, -30, 0, 22),
		Parent = body,
	})

	create("TextLabel", {
		Text = content,
		Font = theme.Font,
		TextSize = 13,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 26),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = body,
	})

	local progressBg = create("Frame", {
		BackgroundColor3 = theme.SurfaceLight,
		Position = UDim2.new(0, 0, 1, 4),
		Size = UDim2.new(1, 0, 0, 3),
		Parent = body,
	}, { corner(2) })
	local progressFill = create("Frame", {
		BackgroundColor3 = accentColor,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = progressBg,
	}, { corner(2) })

	-- entrance: slide + fade in
	frame.Position = UDim2.new(0, 40, 0, 0)
	frame.BackgroundTransparency = 1
	tween(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 0,
	})
	tween(progressFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })

	task.delay(duration, function()
		tween(frame, TweenInfo.new(0.25), { BackgroundTransparency = 1, Position = UDim2.new(0, 40, 0, 0) })
		task.wait(0.25)
		frame:Destroy()
	end)
end

