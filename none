					Parent = sec.Holder,
				})
			end

			--====================================================
			-- BUTTON
			--====================================================
			function sec:AddButton(cfg)
				cfg = cfg or {}
				local btn2 = create("TextButton", {
					Text = cfg.Text or "Button",
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.Text,
					BackgroundColor3 = theme.Accent,
					Size = UDim2.new(1, 0, 0, 34),
