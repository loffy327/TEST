		Section:AddToggle({ Text = "Auto Farm", Default = false, Callback = function(v) end })
		Section:AddSlider({ Text = "Speed", Min = 0, Max = 100, Default = 16, Callback = function(v) end })
		Section:AddDropdown({ Text = "Mode", Options = {"A","B","C"}, Multi = false, Callback = function(v) end })
		Section:AddInput({ Text = "Player name", Placeholder = "Nhập tên...", Callback = function(text, enter) end })
