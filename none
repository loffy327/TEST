		Position = UDim2.new(0, 150, 0, 44),
		Size = UDim2.new(1, -150, 1, -44),
		Parent = win.Main,
	})

	function win:CreateTab(name)
		local Tab = {}
		Tab.__index = Tab
		setmetatable(Tab, { __index = Tab })

		local tabObj = setmetatable({}, Tab)
		tabObj.Theme = theme
		tabObj.Name = name

		local tabIcon = type(name) == "table" and name.Icon or nil
		local tabName = type(name) == "table" and name.Name or name

		local btn = create("TextButton", {
			Text = "",
			BackgroundColor3 = theme.SurfaceLight,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 34),
			Parent = win.TabColumn,
		}, { corner(6) })

		local btnLabel = create("TextLabel", {
			Text = tabName,
			Font = theme.Font,
			TextSize = 14,
			TextColor3 = theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, tabIcon and 34 or 12, 0, 0),
			Size = UDim2.new(1, tabIcon and -40 or -20, 1, 0),
			Parent = btn,
		})

		if tabIcon then
			create("ImageLabel", {
				Image = tabIcon,
				ImageColor3 = theme.SubText,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 8, 0.5, -9),
				Size = UDim2.new(0, 18, 0, 18),
				Parent = btn,
			})
		end

		btn.MouseEnter:Connect(function()
			if btn.BackgroundTransparency > 0 then
				tween(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.6 })
			end
		end)
		btn.MouseLeave:Connect(function()
			if btn.BackgroundTransparency < 1 and btn.BackgroundTransparency > 0 then
				tween(btn, TweenInfo.new(0.15), { BackgroundTransparency = 1 })
			end
		end)

		local page = create("ScrollingFrame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = theme.Accent,
			Visible = false,
			Parent = win.PageHolder,
		})
		create("UIListLayout", {
			Parent = page,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		create("UIPadding", {
			Parent = page,
			PaddingTop = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
			PaddingBottom = UDim.new(0, 12),
		})

		tabObj.Button = btn
		tabObj.Label = btnLabel
		tabObj.Page = page

		local function setActive(activeTab)
			for _, t in pairs(win.Tabs) do
				local isActive = t == activeTab
				t.Page.Visible = isActive
				tween(t.Button, TweenInfo.new(0.15), {
					BackgroundColor3 = isActive and theme.Accent or theme.SurfaceLight,
					BackgroundTransparency = isActive and 0 or 1,
				})
				t.Label.TextColor3 = isActive and Color3.new(1, 1, 1) or theme.SubText
			end
		end

		btn.MouseButton1Click:Connect(function()
			setActive(tabObj)
		end)

		if #win.Tabs == 0 then
			task.defer(setActive, tabObj)
		end

