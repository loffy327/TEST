	 Single ModuleScript build - dễ giao source, dễ minify.

	 API Overview:
		local UI = require(path.to.ProUILib)
		local Window = UI:CreateWindow({
			Title = "My Game", SubTitle = "v1.0", Icon = "rbxassetid://0", Theme = "Dark",
		})
		local Tab = Window:CreateTab({ Name = "Main", Icon = "rbxassetid://0" }) -- hoặc chỉ "Main"
