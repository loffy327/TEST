				}, { corner(6), stroke(theme.Border), padding(8) })

				local grid = create("UIGridLayout", {
					CellSize = UDim2.new(0, 24, 0, 24),
					CellPadding = UDim2.new(0, 6, 0, 6),
					Parent = panel,
				})

				local presets = {
					Color3.fromRGB(255, 89, 89), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 224, 74),
					Color3.fromRGB(87, 201, 124), Color3.fromRGB(74, 194, 224), Color3.fromRGB(88, 101, 242),
					Color3.fromRGB(178, 102, 255), Color3.fromRGB(255, 105, 180), Color3.fromRGB(255, 255, 255),
					Color3.fromRGB(180, 180, 180), Color3.fromRGB(90, 90, 90), Color3.fromRGB(20, 20, 20),
				}

				for _, col in ipairs(presets) do
					local swBtn = create("TextButton", {
						Text = "",
						BackgroundColor3 = col,
						ZIndex = 6,
						Parent = panel,
					}, { corner(5) })
