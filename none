					if cfg.Callback then
						task.spawn(cfg.Callback)
					end
				end)

				return btn2
			end

			--====================================================
			-- TOGGLE
			--====================================================
			function sec:AddToggle(cfg)
				cfg = cfg or {}
				local state = cfg.Default or false

				local row = create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 28),
					Parent = sec.Holder,
				})

				create("TextLabel", {
					Text = cfg.Text or "Toggle",
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, -50, 1, 0),
					Parent = row,
				})

				local track = create("Frame", {
					BackgroundColor3 = state and theme.Accent or theme.SurfaceLight,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.new(0, 40, 0, 22),
					Parent = row,
				}, { corner(11) })

				local knob = create("Frame", {
					BackgroundColor3 = Color3.new(1, 1, 1),
					Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(0, 18, 0, 18),
					Parent = track,
				}, { corner(9) })

				local clickArea = create("TextButton", {
					Text = "",
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 1, 0),
					Parent = track,
				})

				clickArea.MouseButton1Click:Connect(function()
					state = not state
					tween(track, TweenInfo.new(0.15), {
						BackgroundColor3 = state and theme.Accent or theme.SurfaceLight,
					})
					tween(knob, TweenInfo.new(0.15), {
						Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
					})
					if cfg.Callback then
						task.spawn(cfg.Callback, state)
					end
				end)

				return {
					Set = function(_, value)
						state = value
						track.BackgroundColor3 = state and theme.Accent or theme.SurfaceLight
						knob.Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
					end,
					Get = function()
						return state
					end,
				}
			end

			--====================================================
			-- SLIDER
			--====================================================
			function sec:AddSlider(cfg)
				cfg = cfg or {}
				local min = cfg.Min or 0
				local max = cfg.Max or 100
				local value = cfg.Default or min
				local dragging = false

				local row = create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 42),
					Parent = sec.Holder,
				})

				local label = create("TextLabel", {
					Text = (cfg.Text or "Slider") .. ": " .. tostring(value),
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 18),
					Parent = row,
				})

				local barBg = create("Frame", {
					BackgroundColor3 = theme.SurfaceLight,
					Position = UDim2.new(0, 0, 0, 26),
					Size = UDim2.new(1, 0, 0, 8),
					Parent = row,
				}, { corner(4) })

				local function ratio(v)
					return math.clamp((v - min) / (max - min), 0, 1)
				end

				local fill = create("Frame", {
					BackgroundColor3 = theme.Accent,
					Size = UDim2.new(ratio(value), 0, 1, 0),
					Parent = barBg,
				}, { corner(4) })

				local grabber = create("TextButton", {
					Text = "",
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 1, 0),
					Parent = barBg,
				})

				local function updateFromInput(inputPos)
					local rel = math.clamp((inputPos.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
					value = math.floor(min + (max - min) * rel)
					fill.Size = UDim2.new(rel, 0, 1, 0)
					label.Text = (cfg.Text or "Slider") .. ": " .. tostring(value)
					if cfg.Callback then
						task.spawn(cfg.Callback, value)
					end
				end

				grabber.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						updateFromInput(input.Position)
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch) then
						updateFromInput(input.Position)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				return {
					Set = function(_, v)
						value = math.clamp(v, min, max)
						fill.Size = UDim2.new(ratio(value), 0, 1, 0)
						label.Text = (cfg.Text or "Slider") .. ": " .. tostring(value)
					end,
					Get = function()
						return value
					end,
				}
			end

			--====================================================
			-- DROPDOWN (menu cuộn - scrollable list, hỗ trợ Multi)
			--====================================================
			function sec:AddDropdown(cfg)
				cfg = cfg or {}
				local options = cfg.Options or {}
				local multi = cfg.Multi or false
				local selected = cfg.Default or (multi and {} or options[1])
				local open = false
				local optionButtons = {}

				local function isSelected(opt)
					if multi then
						for _, v in ipairs(selected) do
							if v == opt then return true end
						end
						return false
					end
					return selected == opt
				end

				local function displayText()
					if multi then
						if #selected == 0 then return (cfg.Text or "Select") .. ": None" end
						return (cfg.Text or "Select") .. ": " .. table.concat(selected, ", ")
					end
					return (cfg.Text or "Select") .. ": " .. tostring(selected)
				end

				local row = create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 34),
					ClipsDescendants = false,
					ZIndex = 4,
					Parent = sec.Holder,
				})

				local main = create("TextButton", {
					Text = "",
					BackgroundColor3 = theme.SurfaceLight,
					Size = UDim2.new(1, 0, 0, 34),
					ZIndex = 4,
					Parent = row,
				}, { corner(6) })

				local mainLabel = create("TextLabel", {
					Text = displayText(),
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 10, 0, 0),
					Size = UDim2.new(1, -34, 1, 0),
					Parent = main,
				})

				local arrow = create("TextLabel", {
					Text = "▾",
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.SubText,
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					Size = UDim2.new(0, 16, 1, 0),
					Parent = main,
				})

				-- menu cuộn: giới hạn chiều cao, tự bật scrollbar khi nhiều lựa chọn
				local maxVisible = 5
				local itemHeight = 28
				local listHeight = math.min(#options, maxVisible) * itemHeight + 8

				local list = create("ScrollingFrame", {
					BackgroundColor3 = theme.SurfaceLight,
					Position = UDim2.new(0, 0, 1, 4),
					Size = UDim2.new(1, 0, 0, listHeight),
					CanvasSize = UDim2.new(0, 0, 0, #options * itemHeight + 8),
					ScrollBarThickness = 3,
					ScrollBarImageColor3 = theme.Accent,
					ClipsDescendants = true,
					Visible = false,
					ZIndex = 6,
					Parent = row,
				}, { corner(6), stroke(theme.Border), padding(4) })

				create("UIListLayout", {
					Parent = list,
					SortOrder = Enum.SortOrder.LayoutOrder,
				})

				local function refreshHighlight()
					for opt, optBtn in pairs(optionButtons) do
						optBtn.BackgroundTransparency = isSelected(opt) and 0 or 1
						optBtn.TextColor3 = isSelected(opt) and Color3.new(1, 1, 1) or theme.Text
					end
				end

				for _, opt in ipairs(options) do
					local optBtn = create("TextButton", {
						Text = "  " .. tostring(opt),
						Font = theme.Font,
						TextSize = 13,
						TextColor3 = theme.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
						BackgroundColor3 = theme.Accent,
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 26),
						ZIndex = 6,
						Parent = list,
					}, { corner(4) })
					optionButtons[opt] = optBtn

					optBtn.MouseButton1Click:Connect(function()
						if multi then
							if isSelected(opt) then
								for i, v in ipairs(selected) do
									if v == opt then table.remove(selected, i) break end
								end
							else
								table.insert(selected, opt)
							end
						else
							selected = opt
							list.Visible = false
							open = false
						end
						mainLabel.Text = displayText()
						refreshHighlight()
						if cfg.Callback then
							task.spawn(cfg.Callback, selected)
						end
					end)
				end
				refreshHighlight()

				main.MouseButton1Click:Connect(function()
					open = not open
					list.Visible = open
					tween(arrow, TweenInfo.new(0.15), { Rotation = open and 180 or 0 })
				end)

				return {
					Set = function(_, v)
						selected = v
						mainLabel.Text = displayText()
						refreshHighlight()
					end,
					Get = function()
						return selected
					end,
				}
			end

			--====================================================
			-- INPUT / TEXTBOX
			--====================================================
			function sec:AddInput(cfg)
				cfg = cfg or {}
				local box = create("TextBox", {
					Text = cfg.Default or "",
					PlaceholderText = cfg.Placeholder or cfg.Text or "Nhập...",
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.Text,
					PlaceholderColor3 = theme.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false,
					BackgroundColor3 = theme.SurfaceLight,
					Size = UDim2.new(1, 0, 0, 34),
					Parent = sec.Holder,
				}, { corner(6), padding(10) })

				box.Focused:Connect(function()
					tween(box, TweenInfo.new(0.15), { BackgroundColor3 = theme.Surface })
				end)
				box.FocusLost:Connect(function(enterPressed)
					tween(box, TweenInfo.new(0.15), { BackgroundColor3 = theme.SurfaceLight })
					if cfg.Callback then
						task.spawn(cfg.Callback, box.Text, enterPressed)
					end
				end)

				return {
					Set = function(_, v) box.Text = v end,
					Get = function() return box.Text end,
				}
			end

			--====================================================
			-- KEYBIND
			--====================================================
			function sec:AddKeybind(cfg)
				cfg = cfg or {}
				local current = cfg.Default or Enum.KeyCode.Unknown
				local listening = false

				local row = create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 30),
					Parent = sec.Holder,
				})

				create("TextLabel", {
					Text = cfg.Text or "Keybind",
					Font = theme.Font,
					TextSize = 14,
					TextColor3 = theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, -90, 1, 0),
					Parent = row,
				})

				local keyBtn = create("TextButton", {
					Text = current.Name,
					Font = theme.Font,
					TextSize = 13,
					TextColor3 = theme.Text,
					BackgroundColor3 = theme.SurfaceLight,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.new(0, 80, 0, 26),
					Parent = row,
				}, { corner(6) })

				keyBtn.MouseButton1Click:Connect(function()
					listening = true
					keyBtn.Text = "..."
				end)

				UserInputService.InputBegan:Connect(function(input, processed)
					if listening and input.UserInputType == Enum.UserInputType.Keyboard then
						current = input.KeyCode
						keyBtn.Text = current.Name
						listening = false
						if cfg.Callback then
							task.spawn(cfg.Callback, current)
						end
					elseif not listening and not processed and cfg.OnPress
						and input.KeyCode == current then
						task.spawn(cfg.OnPress)
					end
				end)

				return {
					Set = function(_, keyCode) current = keyCode; keyBtn.Text = keyCode.Name end,
					Get = function() return current end,
				}
			end

			--====================================================
