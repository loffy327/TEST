		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = theme.SubText,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -44, 0.5, 0),
		Size = UDim2.new(0, 24, 0, 24),
		Parent = win.TopBar,
